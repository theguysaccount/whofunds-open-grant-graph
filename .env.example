# WHOFUNDS settings. Every one is optional: the pipeline and the static site run with none.
# On GitHub, set the public ones as repository variables (Settings → Variables), not secrets.
# Copy to .env for local runs; .env is git-ignored.

# Static build (site/scripts/build-pages.mjs)
WHOFUNDS_BASE_URL=http://localhost:4180/whofunds-open-grant-graph   # canonical origin + path; pages.yml sets the Pages URL
WHOFUNDS_REPO=owner/whofunds-open-grant-graph                       # where "Wrong?" opens correction issues and CSVs download from
WHOFUNDS_OUT=                        # output dir (default site/dist)
WHOFUNDS_DATA_DIR=                   # site data dir (default site/data)
WHOFUNDS_URLS_OUT=                   # landing-page URL list for IndexNow (default site/dist-urls.txt)
WHOFUNDS_BUDGET_ORG_MB=300           # bytes of static org pages, filled by value
WHOFUNDS_BUDGET_FDN_MB=230           # bytes of static foundation pages, filled by value

# The monetization slot and analytics (both off when empty)
WHOFUNDS_SUPPORT_URL=                # funder-alerts signup or donation link
WHOFUNDS_GOATCOUNTER=                # https://<code>.goatcounter.com/count (cookieless)

# Optional server-rendered mode (site/api, Vercel). Not used by GitHub Pages.
WHOFUNDS_MODE=server
WHOFUNDS_ANALYTICS=                  # "vercel" to load Vercel Web Analytics
WHOFUNDS_LOCAL_STORE=                # local corrections/events store for dev.mjs (default site/.local-store)
BLOB_READ_WRITE_TOKEN=               # secret: Vercel Blob token for corrections and events; never commit a value
BLOB_STORE_ID=
PORT=8000                            # dev.mjs
CHROME=                              # Chrome binary for og.mjs and screens.mjs
